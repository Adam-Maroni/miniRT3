DESCRIPTIFS DES FICHIERS:
	rtfiles/1.rt = 
	utils/ft_check* = check la validité du fichier entré en vérifiant le contenu de la structure parser
	utils/ft_init_parser* = initialise les composantes du parser
	utils/ft_error_met.c = appelée quand une erreure est rencontrée: renvoie un message d'erreur, libère la mémoire et interromp le programme
	utils/ft_free_lineaddress = libère la mémoire
	utils/parsing.c = Contient les fonctions permettant de remplir la structure parser
	tests/main_tester_parsing_linkedlist.c = test de parsing avec linked list


DESCRPITIF DES FONCTIONS:
	//Prend en entree un fichier.rt et retourne le premier element d'une liste chainee dont les noeuds sont le parsings des lignes.
	FT_PARSING
	{
		LIRE le fichier ligne par ligne
		SI la ligne est correcte
			INSERER l'objet dans la liste
		SINON
			LIBERER la memoire
			Exit 0
	}
	ft_check_line: check la ligne et renvoie le parser mis en forme si correcte


